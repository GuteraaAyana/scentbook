# Copy this file to .env.local and fill in your values.
# Postgres.app default: your Mac username, no password.
DATABASE_URL=postgres://YOUR_MAC_USERNAME@localhost:5432/scentbook

# Fragella API key, from https://api.fragella.com/dashboard.html (secret: never commit it)
FRAGELLA_API_KEY=

# Better Auth. Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Sign in with GitHub / Google (optional; the buttons only appear when set)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
